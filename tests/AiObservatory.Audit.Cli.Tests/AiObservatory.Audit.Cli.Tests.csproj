<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AiObservatory.Audit.Cli/AiObservatory.Audit.Cli.csproj" />
    <None Include="../fixtures/audit/*" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AiObservatory.Audit.Cli/bin/$(Configuration)/$(TargetFramework)/AiObservatory.Audit.Cli.runtimeconfig.json" Link="AiObservatory.Audit.Cli.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/AiObservatory.Audit.Cli/bin/$(Configuration)/$(TargetFramework)/AiObservatory.Audit.Cli.deps.json" Link="AiObservatory.Audit.Cli.deps.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
