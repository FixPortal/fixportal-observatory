<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MailKit" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiObservatory.Data\AiObservatory.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Routing\routing-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      The unit lane needs the money-path validators (SpendEntriesEndpoints.Validate,
      SpendCatalogEndpoints.Slug/ValidateName/ValidateColorVar, ApiKeyComparer) reachable
      without booting the HTTP pipeline, because host-booting tests live in the integration
      project which Stryker deliberately does not mutate. Internal rather than public so the
      widened reach stops at the test assembly and these stay off the API's surface.
    -->
    <InternalsVisibleTo Include="AiObservatory.Api.Tests" />
    <!-- The integration lane parks the intelligence worker inside its daily delay via the
         internal DelayAsync seam, so a worker cycle can be awaited deterministically. -->
    <InternalsVisibleTo Include="AiObservatory.Api.IntegrationTests" />
  </ItemGroup>

</Project>
