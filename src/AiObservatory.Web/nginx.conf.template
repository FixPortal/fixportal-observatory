# The admin key lives here, not in the JavaScript bundle. The nginx image runs envsubst over
# /etc/nginx/templates at start, replacing only OBSERVATORY_API_KEY (NGINX_ENVSUBST_FILTER in the
# Dockerfile), so nginx's own $variables below are untouched. A request that already carries a key
# (a ?key= viewer link) keeps it; any other request gets the admin key. Do not put a `"`, `\` or `$`
# in OBSERVATORY_API_KEY: it is written into this file as a quoted string.
map $http_x_observatory_key $observatory_key {
    default $http_x_observatory_key;
    ""      "${OBSERVATORY_API_KEY}";
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json image/svg+xml text/css;

    # Proxy API calls to the api container — keeps the frontend same-origin so
    # no CORS and no auth header is needed for read-only requests in dev mode.
    location /api/ {
        proxy_pass http://api:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Observatory-Key $observatory_key;
    }

    # Vite fingerprints production assets, so browsers can safely retain them.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback — all non-asset routes serve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
