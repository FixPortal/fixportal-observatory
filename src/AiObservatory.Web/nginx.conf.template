# The admin key lives here, not in the JavaScript bundle. The nginx image runs envsubst over
# /etc/nginx/templates at start, replacing only OBSERVATORY_API_KEY (NGINX_ENVSUBST_FILTER in the
# Dockerfile), so nginx's own $variables below are untouched. 15-check-observatory-key.sh rejects
# characters that cannot sit inside the quoted string; an unset key is the empty string (Dockerfile),
# which sends no header, so the API answers 401.
#
# SECURITY MODEL: this proxy is an UNAUTHENTICATED ADMIN PROXY. Anything that can reach this port
# and is not rejected by the rules below is sent to the API with the admin key. The image is
# published on loopback only (docker-compose.yml); never expose it beyond the machine. The header
# rules below are CSRF hardening against a browser on the same machine, not authentication: every
# header they read is written by the client, so a non-browser client can set any of them.
#
# The key is added only to requests the SPA itself made. A cross-site page can send a CORS-simple
# POST (a form, or fetch with mode no-cors) with no preflight, so injecting for every keyless
# request would let it drive admin POSTs. Browsers that send Sec-Fetch-Site are trusted on
# same-origin/none; older ones fall back to an Origin equal to the Host header this server
# receives (either scheme). That comparison is against the raw Host, so a proxy in front must
# pass Host through unchanged or a legacy browser's same-origin write is refused. A request with
# neither header is indistinguishable from a browser that omits them (Firefox before 70 sends no
# Origin on a cross-site form POST), so it is trusted only for GET and HEAD, never a write.
# A request that already carries a key (a ?key= viewer link) keeps it.
map "$request_method|$http_sec_fetch_site|$http_origin|$http_host" $same_origin_request {
    default                0;
    "~^[A-Z]+\|same-origin\|"  1;
    "~^[A-Z]+\|none\|"         1;
    "~^(GET|HEAD)\|\|\|"       1;
    "~^[A-Z]+\|\|https?://(.*)\|\1$"  1;
}

map "$same_origin_request|$http_x_observatory_key" $observatory_key {
    default       $http_x_observatory_key;
    "~^1\|$"      "${OBSERVATORY_API_KEY}";
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json image/svg+xml text/css;

    # Proxy API calls to the api container — keeps the frontend same-origin so
    # no CORS and no auth header is needed for read-only requests in dev mode.
    location /api/ {
        proxy_pass http://api:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Observatory-Key $observatory_key;
    }

    # Vite fingerprints production assets, so browsers can safely retain them.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback — all non-asset routes serve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
