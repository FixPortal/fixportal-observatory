{
  "name": "aiobservatory-web",
  "private": true,
  "version": "1.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://observatory.fixportal.org",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:container": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "typecheck": "tsc -b",
    "format": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "gate": "npm run format && npm run lint && npm run build && npm run coverage",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@azure/msal-browser": "5.25.1",
    "@azure/msal-react": "5.7.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/react-query": "5.104.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "archunit": "2.5.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-glob": "file:tools/plantuml-glob",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "plantuml-parser": {
      "fast-glob": "$fast-glob"
    }
  }
}
