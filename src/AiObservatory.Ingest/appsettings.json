{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // These two categories were 79.7% of the whole fpaiobs-ai-law workspace by
      // billed size (2.161 GB of 2.71 GB over 7 days to 2026-08-08), all at
      // severity Information and none of it actionable. EF logs every statement
      // with SQL text and parameter values (486,119 records from this worker
      // alone); the HttpClient pair logs a start and a finish line for every call
      // the GitHub activity poller makes (495,830 records). Left at Information
      // they cost roughly GBP 14/mo in ingestion. Raise either one back to
      // Information temporarily when debugging, but do not commit it.
      //
      // The HttpClient filter is deliberately scoped to IGitHubActivityClient and
      // NOT to the bare "System.Net.Http" category. This worker registers five
      // typed clients (Program.cs:80,95,117,146,160) and only the GitHub activity
      // poller is noisy: over the same 7 days FxRateProvider logged 154 records
      // and github-billing 112, against IGitHubActivityClient's 495,830. None of
      // these clients log around their own requests, so the framework's
      // Information-level request/response lines are the only per-call diagnostic
      // the billing pollers have — and those pollers are what the app exists for.
      // Silencing them would save nothing measurable and cost the diagnostics.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient.IGitHubActivityClient": "Warning"
    }
  },
